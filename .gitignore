# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# The database lives in the repo's data-latest release (npm run db:pull), never in git.
data/knesset.db
# SQLite transient files
*.db-wal
*.db-shm
*.db-journal

# local working status board (not for git)
PROJECT_STATUS.md

# private notes (e.g. questions for the lawyer) — never committed
private/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Impeccable: review captures and decision comps are per-run evidence, not source.
.impeccable/review/
.impeccable/mocks/
.impeccable/questions/
