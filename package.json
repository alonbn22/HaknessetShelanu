{
  "name": "haknesset-sheli",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/fetch-db.mjs --if-missing",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:qa": "node --import tsx --test \"tests/qa/*.test.ts\"",
    "test:security": "node --import tsx --test \"tests/security/*.test.ts\"",
    "sync": "DB_WRITE=1 tsx scripts/sync/index.ts",
    "update": "DB_WRITE=1 tsx scripts/sync/index.ts",
    "translations:export": "tsx scripts/sync/translations.ts export",
    "translations:import": "DB_WRITE=1 tsx scripts/sync/translations.ts import",
    "db:push": "drizzle-kit push --force",
    "db:clean": "node scripts/db-clean.mjs",
    "db:pull": "node scripts/fetch-db.mjs",
    "db:publish": "node scripts/publish-db.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.6",
    "next-intl": "^4.13.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
